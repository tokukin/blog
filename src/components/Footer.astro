import IconBA from "../assets/batb.png";
---

<footer class="footer-margin sticky bottom-0 z-0">
  <!-- <Socials /> -->
  <div
    class="text-foreground/50 flex items-center justify-between text-sm select-none"
  >
    <p>© {year} {siteConfig.author} </p>
    <a href="https://beian.miit.gov.cn/" target="_blank"
        >陇ICP备2025024677号-1</a
      >
      
      
      <a
        href="https://beian.mps.gov.cn/#/query/webSearch?code=62010202004813"
        rel="noreferrer"
        target="_blank"
        style="display: flex; flex-direction: row; align-items: center; justify-content: center;"
        ><img
        style="width: 15px"
        src="../batb.png"
        alt="甘公网安备62010202004813号"
      />甘公网安备62010202004813号</a
      >
    <p>
      powered by <a
        href="https://astro.build"
        target="blank"
        class="hover:text-accent"
        aria-label="astro site">Astro</a
      > 
    </p>
